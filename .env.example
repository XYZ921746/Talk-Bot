# ===== 服务端 =====
PORT=3210
HOST=0.0.0.0

# ===== LLM（网页设置里填的 API Key 优先于这里；这里只是服务端兜底默认值）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== Azure 语音（STT/TTS 可选）=====
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ===== 免费 TTS（edge-tts，无需任何密钥）=====
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS 目标输出语言（LLM 输出语言不符时自动翻译成该语言再合成）
TTS_LANGUAGE=zh-CN

# ===== 语音识别（STT）=====
# 类型：openai / azure / tencent / baidu / xfyun / none（网页设置里填的优先于这里）
STT_TYPE=tencent
STT_LANGUAGE=

# 腾讯云 ASR（type=tencent）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh

# 百度短语音识别（type=baidu）
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# 讯飞一句话识别（type=xfyun）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_ASR_LANGUAGE=zh_cn
XFYUN_ASR_ACCENT=mandarin

# ===== 语音活动检测（VAD）=====
VAD_THRESHOLD=0.015
VAD_SILENCE_MS=650
VAD_MAX_SPEECH_MS=15000
